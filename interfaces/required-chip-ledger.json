          "amount"
        ],
        "additionalProperties": false
      },
      "Award": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "eligible": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "winners": {
            "type": "array",
            "items": {
