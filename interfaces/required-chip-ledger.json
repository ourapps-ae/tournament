          "seat"
        ],
        "additionalProperties": false
      },
      "Stake": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "seat": {
            "type": "integer",
            "minimum": 0
          },
          "stack": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "bet": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Chips in front of the player this betting round."
          },
          "totalIn": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Chips in this hand."
          },
          "folded": {
            "type": "boolean"
          }
