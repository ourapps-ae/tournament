          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "chips",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    {
      "name": "issued",
      "description": "Every chip ever issued.",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "ledger",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Ledger"
          }
        }
      ],
      "result": {
        "name": "chips",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    {
      "name": "setSeats",
      "description": "Tell the ledger where each player sits (the odd chip goes clockwise from the button by seat).",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "ledger",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Ledger"
          }
        },
        {
          "name": "seats",
          "required": true,
          "schema": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SeatEntry"
            }
          }
        }
      ],
      "result": {
        "name": "ledger",
        "schema": {
          "$ref": "#/components/schemas/Ledger"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/UnknownPlayer"
        },
        {
          "$ref": "#/components/errors/BadSeat"
        },
        {
          "$ref": "#/components/errors/SharedSeat"
        }
      ]
    },
    {
      "name": "setStacks",
      "description": "Each listed player's stack becomes the given number and their wagers clear. The listed players must hold the same total (stacks plus wagers) after as before.",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "ledger",
          "required": true,
