{
  "openrpc": "1.3.2",
  "info": {
    "title": "ae/chip-ledger",
    "version": "1.0.0",
    "description": "Whole-number chip accounting: stacks, bets, pots and side pots, odd chips. No game rules and no card knowledge: callers say who won each pot. Every function returns a new ledger and never changes its input. TypeScript, `implementation/server/ledger.ts`. Methods named `LedgerApi.<name>` are members of the object createLedgerApi returns (the operations a tournament calls, with the settings bound)."
  },
  "methods": [
    {
      "name": "validateSettings",
      "description": "Fill defaults (startingStack 5000, minimumUnit 1, oddChipRule clockwise-after-button, sidePots true, seats 9) and check the settings.",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "settings",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/PartialLedgerSettings"
          },
          "description": "Missing settings take the defaults."
        }
      ],
      "result": {
        "name": "settings",
        "schema": {
          "$ref": "#/components/schemas/LedgerSettings"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/BadStartingStack"
        },
        {
          "$ref": "#/components/errors/BadMinimumUnit"
        },
        {
          "$ref": "#/components/errors/BadOddChipRule"
        },
        {
          "$ref": "#/components/errors/BadSidePots"
        },
        {
          "$ref": "#/components/errors/BadSeats"
        }
      ]
    },
    {
      "name": "create",
      "description": "An empty ledger: nobody in it, nothing issued. The same as openLedger([], settings).",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "settings",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/PartialLedgerSettings"
          },
          "description": "Missing settings take the defaults."
        }
      ],
      "result": {
        "name": "ledger",
        "schema": {
          "$ref": "#/components/schemas/Ledger"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/BadStartingStack"
        },
        {
          "$ref": "#/components/errors/BadMinimumUnit"
        },
        {
          "$ref": "#/components/errors/BadOddChipRule"
        },
        {
          "$ref": "#/components/errors/BadSidePots"
        },
        {
          "$ref": "#/components/errors/BadSeats"
        }
      ]
    },
    {
      "name": "openLedger",
      "description": "A ledger with every listed player holding the starting stack.",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "entries",
          "required": true,
          "schema": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SeatEntry"
            }
          }
        },
        {
          "name": "settings",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/PartialLedgerSettings"
          },
          "description": "Missing settings take the defaults."
        }
      ],
      "result": {
        "name": "ledger",
        "schema": {
          "$ref": "#/components/schemas/Ledger"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/BadStartingStack"
        },
        {
          "$ref": "#/components/errors/BadMinimumUnit"
        },
        {
          "$ref": "#/components/errors/BadOddChipRule"
        },
        {
          "$ref": "#/components/errors/BadSidePots"
        },
        {
          "$ref": "#/components/errors/BadSeats"
        },
        {
          "$ref": "#/components/errors/DuplicateId"
        }
      ]
    },
    {
      "name": "issue",
      "description": "New chips for a player: the first issue adds the player (seat = the order added, until setSeats says otherwise); later ones add to the stack. Counted as issued either way.",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "ledger",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Ledger"
          }
        },
        {
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "amount",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      ],
      "result": {
        "name": "ledger",
        "schema": {
          "$ref": "#/components/schemas/Ledger"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/NoId"
        },
        {
          "$ref": "#/components/errors/BadAmount"
        }
      ]
    },
    {
      "name": "balance",
      "description": "Chips a player holds behind, not counting wagers; 0 for someone never issued any.",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "ledger",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Ledger"
          }
