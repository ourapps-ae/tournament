          "$ref": "#/components/errors/BadOddChipRule"
        },
        {
          "$ref": "#/components/errors/BadSidePots"
        },
        {
          "$ref": "#/components/errors/BadSeats"
        }
      ]
    },
    {
      "name": "LedgerApi.settings",
      "description": "The checked settings.",
      "paramStructure": "by-position",
      "params": [],
      "result": {
        "name": "settings",
        "schema": {
          "$ref": "#/components/schemas/LedgerSettings"
        }
      },
      "x-ourapps-property": true
    },
    {
      "name": "LedgerApi.create",
      "description": "An empty ledger with the bound settings.",
      "paramStructure": "by-position",
      "params": [],
