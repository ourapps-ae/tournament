      "paramStructure": "by-position",
      "params": [
        {
          "name": "ledger",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Ledger"
          }
        },
        {
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "to",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "object",
          "properties": {
            "ledger": {
              "$ref": "#/components/schemas/Ledger"
            },
            "committed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
