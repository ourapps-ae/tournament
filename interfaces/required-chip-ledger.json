  "components": {
    "schemas": {
      "OddChipRule": {
        "type": "string",
        "enum": [
          "clockwise-after-button",
          "first-listed"
        ],
        "default": "clockwise-after-button"
      },
      "LedgerSettings": {
        "type": "object",
        "properties": {
          "startingStack": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "default": 5000
          },
          "minimumUnit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "default": 1,
            "description": "Smallest chip. Bets are multiples of it unless they put the whole stack in; odd chips are handed out in this size."
          },
          "oddChipRule": {
            "$ref": "#/components/schemas/OddChipRule"
          },
          "sidePots": {
            "type": "boolean",
            "default": true,
            "description": "true: one pot per contribution level. false: a single pot of everything wagered."
          },
          "seats": {
            "type": "integer",
            "minimum": 2,
            "maximum": 9007199254740991,
            "default": 9,
            "description": "Seats at the table, used to count clockwise from the button."
          }
        },
        "required": [
          "startingStack",
          "minimumUnit",
          "oddChipRule",
          "sidePots",
          "seats"
        ],
        "additionalProperties": false
      },
      "PartialLedgerSettings": {
        "type": "object",
        "properties": {
          "startingStack": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "default": 5000
          },
          "minimumUnit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "default": 1,
            "description": "Smallest chip. Bets are multiples of it unless they put the whole stack in; odd chips are handed out in this size."
          },
          "oddChipRule": {
            "$ref": "#/components/schemas/OddChipRule"
          },
          "sidePots": {
            "type": "boolean",
            "default": true,
            "description": "true: one pot per contribution level. false: a single pot of everything wagered."
          },
          "seats": {
            "type": "integer",
            "minimum": 2,
            "maximum": 9007199254740991,
            "default": 9,
            "description": "Seats at the table, used to count clockwise from the button."
          }
        },
        "additionalProperties": false,
        "description": "Any subset of LedgerSettings."
      },
      "SeatEntry": {
        "type": "object",
