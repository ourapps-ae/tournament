            "$ref": "#/components/schemas/Ledger"
          }
        },
        {
          "name": "stacks",
          "required": true,
          "schema": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "description": "Player id to stack."
          }
        }
      ],
      "result": {
        "name": "ledger",
        "schema": {
          "$ref": "#/components/schemas/Ledger"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/UnknownPlayer"
        },
        {
          "$ref": "#/components/errors/BadStack"
        },
        {
          "$ref": "#/components/errors/StacksChanged"
        }
      ]
    },
    {
      "name": "createLedgerApi",
      "description": "The tournament's operations with the settings bound.",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "settings",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/PartialLedgerSettings"
          },
